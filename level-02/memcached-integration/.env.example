# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=dev

# Memcached (comma-separated for multiple servers)
# Local dev:
MEMCACHED_SERVERS=127.0.0.1:11211
# Docker compose (service name):
# MEMCACHED_SERVERS=memcached:11211

# Default TTL in seconds (used if not provided in requests)
CACHE_DEFAULT_TTL=60

# Optional Memcached options (JSON)
MEMCACHED_OPTIONS={"retries":1,"retry":10000,"remove":false,"timeout":5000}

# Optional key prefix for namespacing
CACHE_KEY_PREFIX=app:
