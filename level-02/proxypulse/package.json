{
  "name": "proxypulse",
  "version": "1.0.0",
  "description": "ProxyPulse (URL + VPN Checker): a real-world tool to check URL reachability and detect likely VPN/proxy usage, via CLI or API.",
  "type": "module",
  "bin": {
    "proxypulse": "src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "cli": "node src/cli.js",
    "test-url": "node src/cli.js check-url https://example.com",
    "test-vpn": "node src/cli.js check-vpn"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dns-over-http-resolver": "^2.1.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  },
  "keywords": [
    "url checker",
    "vpn detector",
    "proxy",
    "uptime",
    "cli",
    "api"
  ],
  "license": "MIT",
  "author": "Ayesha Iftikhar @ Aishayy"
}
