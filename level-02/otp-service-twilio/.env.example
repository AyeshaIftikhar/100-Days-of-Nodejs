# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=1h

# OTP
OTP_TTL_SECONDS=300          # 5 minutes
OTP_RESEND_COOLDOWN=60       # 60 seconds before another send allowed
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=replace_with_another_random_secret_pepper

# Twilio (choose either Messaging Service SID or FROM number)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# or
# TWILIO_FROM=+1234567890

# Redis (optional - if not set, uses in-memory store)
REDIS_URL=redis://redis:6379
