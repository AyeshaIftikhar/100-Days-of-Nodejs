<h1>Search</h1>
<form action="/search" method="get" class="search">
  <input name="q" value="<%= q %>" placeholder="Try "vector DB", "KMS", "PCI DSS"…"/>
  <button type="submit">Search</button>
</form>

<% if (q && results.length === 0) { %>
  <p>No results for "<%= q %>".</p>
<% } %>

<ul class="list">
  <% results.forEach(p => { %>
    <li>
      <a href="<%= p.url %>"><%= p.title %></a>
      <div class="small"><%= p.excerpt %>…</div>
    </li>
  <% }) %>
</ul> %>
