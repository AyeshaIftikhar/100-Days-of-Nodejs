{
  "name": "automated-testing-framework",
  "version": "1.0.0",
  "description": "A comprehensive automated testing framework for web applications",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:api": "jest --testPathPattern=tests/api",
    "test:ui": "jest --testPathPattern=tests/ui",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "test:performance": "jest --testPathPattern=tests/performance",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "node index.js"
  },
  "keywords": [
    "testing",
    "automation",
    "framework",
    "jest",
    "puppeteer",
    "api",
    "ui",
    "e2e",
    "performance"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fs-extra": "^11.1.1",
    "joi": "^17.11.0",
    "lodash": "^4.17.21",
    "puppeteer": "^21.5.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "jest-html-reporter": "^3.10.2",
    "jest-junit": "^16.0.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports",
          "outputName": "junit.xml"
        }
      ],
      [
        "jest-html-reporter",
        {
          "pageTitle": "Test Report",
          "outputPath": "reports/test-report.html"
        }
      ]
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!**/node_modules/**"
    ],
    "coverageDirectory": "reports/coverage"
  }
}
