{
  "name": "passwordless-auth",
  "version": "1.0.0",
  "description": "A production-ready, **passwordless authentication** service using Node.js, Express, SQLite (via better-sqlite3), Nodemailer, and JWT **HttpOnly cookies**. Users sign in via **magic link** or **6‑digit code** sent to email. No passwords to forget or leak.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint ."
  },
  "keywords": [
    "passwordless",
    "magic link",
    "otp",
    "node",
    "express",
    "sqlite",
    "jwt"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "sqlite3": "^5.1.7",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.7",
    "nodemailer": "^6.9.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-n": "^16.3.1",
    "eslint-plugin-promise": "^6.6.0",
    "nodemon": "^3.1.4"
  }
}
