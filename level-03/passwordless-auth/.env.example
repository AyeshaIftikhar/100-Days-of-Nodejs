# Server
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development

# JWT (used for the session cookie)
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=sid
COOKIE_DOMAIN=localhost

# Mail (set these for real SMTP; otherwise, app falls back to console/file preview)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Passwordless Demo <no-reply@example.com>

# Token settings
LOGIN_TOKEN_TTL_MINUTES=15
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_MAX_REQUESTS=20
EMAIL_DAILY_LIMIT=25
