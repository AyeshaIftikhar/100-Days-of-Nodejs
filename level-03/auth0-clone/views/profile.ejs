<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Auth0 Clone - Profile</title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
  <div class="container">
    <header>
      <h1>Auth0 Clone</h1>
      <nav>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/profile" class="active">Profile</a></li>
          <li><a href="#" id="logoutLink">Logout</a></li>
        </ul>
      </nav>
    </header>

    <main>
      <section class="profile-container">
        <div class="profile-card">
          <div class="profile-header">
            <div id="profile-picture" class="profile-picture">
              <!-- Profile picture will be inserted here by JS -->
            </div>
            <div class="profile-title">
              <h2 id="profile-name">Loading...</h2>
              <p id="profile-email">Loading...</p>
            </div>
          </div>
          
          <div class="profile-content">
            <div class="profile-section">
              <h3>Profile Information</h3>
              <div id="profile-update-success" class="success-message" style="display: none;"></div>
              <div id="profile-update-error" class="error-message" style="display: none;"></div>
              
              <form id="profile-form">
                <div class="form-group">
                  <label for="firstName">First Name</label>
                  <input type="text" id="firstName" name="firstName" required>
                </div>
                
                <div class="form-group">
                  <label for="lastName">Last Name</label>
                  <input type="text" id="lastName" name="lastName" required>
                </div>
                
                <div class="form-group">
                  <label for="picture">Profile Picture URL</label>
                  <input type="url" id="picture" name="picture">
                </div>
                
                <div class="form-actions">
                  <button type="submit" class="btn primary">Update Profile</button>
                </div>
              </form>
            </div>
            
            <div class="profile-section">
              <h3>Security</h3>
              <div id="password-update-success" class="success-message" style="display: none;"></div>
              <div id="password-update-error" class="error-message" style="display: none;"></div>
              
              <form id="password-form">
                <div class="form-group">
                  <label for="currentPassword">Current Password</label>
                  <input type="password" id="currentPassword" name="currentPassword" required>
                </div>
                
                <div class="form-group">
                  <label for="newPassword">New Password</label>
                  <input type="password" id="newPassword" name="newPassword" required>
                </div>
                
                <div class="form-group">
                  <label for="confirmPassword">Confirm New Password</label>
                  <input type="password" id="confirmPassword" name="confirmPassword" required>
                </div>
                
                <div class="form-actions">
                  <button type="submit" class="btn primary">Change Password</button>
                </div>
              </form>
            </div>
            
            <div class="profile-section">
              <h3>Connected Accounts</h3>
              <div id="social-connections">
                <div class="social-connection">
                  <div class="social-connection-info">
                    <span class="social-icon google">G</span>
                    <span class="social-name">Google</span>
                  </div>
                  <div id="google-status" class="connection-status">
                    Not Connected
                  </div>
                  <button id="google-connect" class="btn small">Connect</button>
                </div>
                
                <div class="social-connection">
                  <div class="social-connection-info">
                    <span class="social-icon github">GH</span>
                    <span class="social-name">GitHub</span>
                  </div>
                  <div id="github-status" class="connection-status">
                    Not Connected
                  </div>
                  <button id="github-connect" class="btn small">Connect</button>
                </div>
              </div>
            </div>
            
            <div class="profile-section danger-zone">
              <h3>Danger Zone</h3>
              <div class="danger-actions">
                <button id="logout-all-devices" class="btn danger">Logout from All Devices</button>
                <button id="delete-account" class="btn danger">Delete Account</button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <p>&copy; 2025 Auth0 Clone</p>
    </footer>
  </div>

  <script src="/js/auth.js"></script>
  <script src="/js/profile.js"></script>
</body>
</html>
