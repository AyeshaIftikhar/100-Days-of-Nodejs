# Example Environment Configuration
# Copy this file to .env and update with your values

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend Configuration (for production builds)
VITE_API_URL=http://localhost:3001

# Security (for production)
JWT_SECRET=your-super-secret-jwt-key-here
SESSION_SECRET=your-session-secret-here

# Git Configuration (optional)
GIT_USERNAME=your-git-username
GIT_EMAIL=your-email@example.com

# Webhook Configuration (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# Database Configuration (for future use)
DATABASE_URL=postgresql://username:password@localhost:5432/deployment_bot

# Storage Configuration (for deployment files)
STORAGE_PATH=./deployments
MAX_DEPLOYMENT_SIZE=1GB

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/deployment-bot.log
