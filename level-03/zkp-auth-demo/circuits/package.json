{
  "name": "zkp-auth-demo-circuits",
  "version": "1.0.0",
  "description": "Zero-knowledge proof circuits for authentication",
  "main": "index.js",
  "scripts": {
    "build": "npm run compile && npm run setup",
    "compile": "circom src/password_checker.circom --r1cs --wasm --sym -o build/",
    "setup": "node scripts/setup.js",
    "generate-proof": "node scripts/generate-proof.js",
    "verify-proof": "node scripts/verify-proof.js"
  },
  "keywords": [
    "zero-knowledge-proof",
    "zkp",
    "circom",
    "snarkjs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "circomlib": "^2.0.5",
    "snarkjs": "^0.7.1"
  },
  "devDependencies": {
    "circom": "^0.5.46"
  }
}
