<%- include('../layout', { title: title }) %>

<div class="row">
  <div class="col-md-6">
    <img src="<%= product.image %>" class="img-fluid rounded" alt="<%= product.name %>">
  </div>
  <div class="col-md-6">
    <h2><%= product.name %></h2>
    <p class="text-muted">Category: <%= product.category %></p>
    <p><%= product.description %></p>
    <p class="h3 mb-4">$<%= product.price.toFixed(2) %></p>
    
    <form action="/checkout" method="GET">
      <input type="hidden" name="productId" value="<%= product._id %>">
      <div class="mb-3">
        <label for="quantity" class="form-label">Quantity</label>
        <input type="number" class="form-control" id="quantity" name="quantity" value="1" min="1" max="10">
      </div>
      <button type="submit" class="btn btn-success btn-lg">Buy Now</button>
    </form>
    
    <a href="/products" class="btn btn-link mt-3">Back to Products</a>
  </div>
</div>
